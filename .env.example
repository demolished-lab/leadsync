# ============================================
# AI Sales Follow-Up Agent — Environment Config
# ============================================
# Copy to .env and fill in your values.

# --- LLM Provider ---
# Options: ollama (local), openai, anthropic, nim, google, groq
LLM_PROVIDER=ollama

# Cloud API keys (only needed for cloud providers)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
NVIDIA_API_KEY=
GROQ_API_KEY=

# LLM model settings
LLM_MODEL_GENERATION=gpt-4o-mini
LLM_MODEL_SCORING=gpt-4o-mini
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=500

# --- Ollama / Local Models ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL_PRIMARY=llama3.1:8b
OLLAMA_MODEL_FALLBACK=llama3.2:1b

# --- Email (IMAP) ---
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=

# --- Email (SMTP Sending) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_SENDING_DOMAIN=sales@yourcompany.com
EMAIL_TRACKING_ENABLED=true

# --- SLA & Alerts ---
SLA_HIGH_HOURS=24
SLA_MEDIUM_HOURS=48
SLA_LOW_HOURS=72
QUEUE_MAX_ITEMS=50
PRIORITY_DECAY_DAYS=7.0
SLA_CHECK_INTERVAL=60
ALERT_COOLDOWN_SECONDS=3600
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_EMAIL=
SLACK_WEBHOOK_URL=
SLACK_CHANNEL=
DISCORD_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=
PAGERDUTY_INTEGRATION_KEY=
OPSGENIE_API_KEY=
OPSGENIE_TEAM=
OPSGENIE_PRIORITY=P2

# --- STT (Speech-to-Text) ---
WHISPER_MODEL_SIZE=base

# --- Compliance ---
SUPPRESSIONS_LIST_PATH=.suppressions.txt
GDPR_COMPLIANCE_ENABLED=true

# --- Security: 2FA Enforcement ---
ENFORCE_2FA_ADMIN=false
ENFORCE_2FA_REP=false
# 2FA Recovery Links
RECOVERY_LINK_TTL_HOURS=1
RECOVERY_MAX_LINKS=3
RECOVERY_BASE_URL=http://localhost:8000
CCPA_COMPLIANCE_ENABLED=true

# --- Server ---
HOST=0.0.0.0
PORT=8000
DEBUG=false

# --- Air-gapped / Offline ---
# When true, no external network calls (LLM clouds, webhooks, Google QR) are made
AIR_GAPPED=false
TRUSTED_PROXIES=

# --- Gmail OAuth (Sign in with Google, like Macro) ---
# Create: Google Cloud → APIs & Services → Credentials → OAuth 2.0 Client ID (Web)
# Add redirect: http://localhost:8000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
GMAIL_TOKEN_PATH=data/gmail_token.json

# --- Tracking ---
# MUST be a publicly reachable URL in production (tracking pixels & click
# redirects in emails resolve against it). localhost only works for local dev.
TRACKING_BASE_URL=http://localhost:8000/track

# --- Redis (optional) ---
USE_REDIS=false
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=change-me-strong-password

# --- Database ---
# Default: local SQLite file — works out of the box (no server needed).
# The data/ directory is created on first run.
DATABASE_URL=sqlite:///./data/leadsync.db

# Production: PostgreSQL for conversation history and audit trail.
# Uncomment ONE of the following two Postgres URLs and comment out the
# SQLite line above. For docker compose, use host "postgres" instead of
# localhost and match POSTGRES_PASSWORD below.
# DATABASE_URL=postgresql://sfa:change-me-postgres@localhost:5432/sfa
# DATABASE_URL=postgresql://sfa:change-me-postgres@postgres:5432/sfa
POSTGRES_DB=sfa
POSTGRES_USER=sfa
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_PORT=5432

# --- Security: Authentication ---
# Comma-separated list of API keys, e.g. API_KEYS=sk-abc123...,sk-xyz789...
# Give RAW keys here — core middleware/auth hashes them internally
# (keys are indexed by sha256(key)[:16]); do not pre-hash.
API_KEYS=
# Set to bootstrap the admin account; if empty, a random token is generated
# at first start (see startup logs) instead of a fixed default password.
ADMIN_PASSWORD=
# Web/UI-facing base URL (used by the Streamlit dashboard and links)
API_BASE_URL=http://localhost:8000
# Inspector debug panel — disable in production
INSPECTOR_ENABLED=true

# --- Monitoring ---
PROMETHEUS_ENABLED=true
METRICS_PORT=9090

# --- Pipeline Configuration ---
PIPELINE_ENABLED=true

